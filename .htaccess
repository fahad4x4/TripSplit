# TripSplit — حماية الملفات الحساسة في جذر المشروع (Apache)

# ملف البيانات القديم (قبل الترحيل إلى data/) وملفات Composer والإعداد المحلي
<FilesMatch "^(expenses\.json|composer\.(json|lock)|config\.local(\.example)?\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

